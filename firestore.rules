rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 게시.
// GM 지정: Firestore 콘솔에서 users/{GM uid} 문서에 role: "gm" (string) 필드를 추가한다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // users/{uid}.role == "gm" 인 계정이 GM. (문서가 없거나 role이 없으면 GM 아님)
    function isGM() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'gm';
    }

    // 플레이어가 직접 수정할 수 있는 로비/인트로 필드. 전투 상태(entry, hp, turn, log 등)는 GM만 쓸 수 있다.
    function onlyLobbyKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'player1_uid', 'player1_name', 'player1_ready',
        'player2_uid', 'player2_name', 'player2_ready',
        'spectators', 'spectator_names', 'swap_request',
        'intro_ready_p1', 'intro_ready_p2', 'intro_done'
      ]);
    }

    // 본인 문서는 쓸 수 있지만 role 필드는 못 건드린다 (스스로 GM이 되는 것 방지). role은 콘솔에서만 지정.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isGM());
      allow create: if signedIn() && request.auth.uid == uid
        && !('role' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if false;
    }

    // 공개 트레이너 카드. 로그인한 사람은 누구나 읽을 수 있고, 본인만 정해진 필드로 쓸 수 있다 (js/publicProfile.js).
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'profileImage', 'cardSlots', 'entry', 'updatedAt']);
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create, delete: if isGM();
      allow update: if isGM() || (signedIn() && onlyLobbyKeys());

      // 플레이어 요청 큐. 본인 uid로 pending 요청만 만들 수 있고, 처리(상태 변경)는 GM만.
      match /actions/{actionId} {
        allow read: if isGM() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.type in ['init', 'move', 'switch', 'leave']
          && request.resource.data.keys().hasOnly(['uid', 'type', 'payload', 'round_no', 'status', 'createdAt']);
        allow update, delete: if isGM();
      }
    }
  }
}
